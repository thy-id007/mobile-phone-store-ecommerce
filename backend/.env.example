# Backend Environment Variables Configuration
NODE_ENV=development
PORT=5000

# PostgreSQL Database Configuration
# Option 1: Full Connection String (Recommended for Supabase, Neon, etc.)
# DATABASE_URL=postgresql://username:password@localhost:5432/mobilestore_db

# Option 2: Individual Connection Parameters (Default Local PostgreSQL)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=mobilestore_db

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_university_mobile_store_2026
JWT_EXPIRES_IN=7d

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
